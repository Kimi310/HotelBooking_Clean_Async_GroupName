                  "",
                  "pm.test(\"Both rooms are booked for the occupied period, one booking each\", function () {",
                  "    var start = pm.collectionVariables.get('occStart');",
                  "    var end = pm.collectionVariables.get('occEnd');",
                  "    var occupying = pm.response.json().filter(function (b) {",
                  "        return b.startDate.indexOf(start) === 0 && b.endDate.indexOf(end) === 0;",
                  "    });",
                  "    pm.expect(occupying.length).to.eql(2);",
                  "    pm.expect(occupying[0].roomId).to.not.eql(occupying[1].roomId);",
