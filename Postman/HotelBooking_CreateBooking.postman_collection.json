        {
          "name": "Bookings - fill every room for occStart..occEnd (repeats until the API answers 409)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// The number of rooms depends on the seed data, so book the same period again and again",
                  "// until the API refuses (409). Then every room is occupied for occStart..occEnd.",
                  "var tries = parseInt(pm.collectionVariables.get('fillTries') || '0') + 1;",
                  "pm.collectionVariables.set('fillTries', tries);",
                  "",
                  "pm.test(\"Attempt is accepted (201) or refused because all rooms are full (409)\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([201, 409]);",
                  "});",
                  "",
                  "if (pm.response.code === 201 && tries < 20) {",
                  "    postman.setNextRequest(pm.info.requestName);   // book again",
                  "} else {",
                  "    pm.collectionVariables.set('fillTries', 0);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/Bookings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "Bookings"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"startDate\": \"{{occStart}}\",\n  \"endDate\": \"{{occEnd}}\",\n  \"customerId\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Bookings - every room has exactly one booking for the occupied period",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"One booking per room, all in different rooms\", function () {",
                  "    var start = pm.collectionVariables.get('occStart');",
                  "    var end = pm.collectionVariables.get('occEnd');",
                  "    var rooms = parseInt(pm.collectionVariables.get('roomCount'));",
                  "    var occupying = pm.response.json().filter(function (b) {",
                  "        return String(b.startDate).indexOf(start) === 0 && String(b.endDate).indexOf(end) === 0;",
                  "    });",
                  "    pm.expect(occupying.length).to.eql(rooms);",
                  "    var ids = occupying.map(function (b) { return b.roomId; });",
                  "    pm.expect(new Set(ids).size).to.eql(ids.length);",
                  "});"
                ]
              }
            }
          ],
