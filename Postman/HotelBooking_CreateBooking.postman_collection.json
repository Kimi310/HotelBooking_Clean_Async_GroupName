        {
          "name": "Bookings - created booking appears in the list",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response is json\", function () {",
                  "    pm.response.to.be.json;",
                  "});",
                  "",
                  "// POST /Bookings returns 201 with an empty body, so the data is verified via the list",
                  "pm.test(\"Created booking is listed with correct data\", function () {",
                  "    var start = pm.collectionVariables.get('validStart');",
                  "    var end = pm.collectionVariables.get('validEnd');",
                  "    var all = pm.response.json();",
                  "    var match = all.find(function (b) {",
                  "        return String(b.startDate).indexOf(start) === 0 && String(b.endDate).indexOf(end) === 0;",
                  "    });",
                  "    pm.expect(match, 'no booking with ' + start + ' -> ' + end + '. First items: ' + JSON.stringify(all.slice(0, 3))).to.exist;",
                  "    pm.expect(match.customerId, 'customerId in list').to.eql(99);",
                  "    pm.expect(match.isActive).to.eql(true);",
                  "    pm.expect(match.roomId).to.be.above(0);",
                  "    pm.collectionVariables.set('createdBookingId', match.id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/Bookings",
              "host": [
                "{{baseUrl}}"
              ],
