{
  "info": {
    "name": "HotelBooking_CreateBooking",
    "description": "API tests for POST /Bookings (CreateBooking). Run against the API in Development: it seeds the customers (ids 1 and 2) and rooms the tests need - a booking for an unknown customer is not returned by the API. The tests do not depend on the seeded bookings: all dates are today+35 or later, and the 'no room' folder fills every room itself. Run the folders in order.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://localhost:5001"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Dates are relative to today so the tests never go stale",
          "function pad(n) { return n < 10 ? '0' + n : '' + n; }",
          "function addDays(n) {",
          "    var d = new Date();",
          "    d.setDate(d.getDate() + n);",
          "    return d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate());",
          "}",
          "pm.collectionVariables.set('today', addDays(0));",
          "pm.collectionVariables.set('pastDate', addDays(-3));",
          "pm.collectionVariables.set('validStart', addDays(60));",
          "pm.collectionVariables.set('validEnd', addDays(61));",
          "pm.collectionVariables.set('occStart', addDays(40));",
          "pm.collectionVariables.set('occEnd', addDays(50));",
          "pm.collectionVariables.set('insideStart', addDays(42));",
          "pm.collectionVariables.set('insideEnd', addDays(45));",
          "pm.collectionVariables.set('overlapStartBefore', addDays(35));",
          "pm.collectionVariables.set('overlapEndInside', addDays(42));",
          "pm.collectionVariables.set('overlapStartInside', addDays(48));",
          "pm.collectionVariables.set('overlapEndAfter', addDays(55));",
          "pm.collectionVariables.set('freeStart', addDays(70));",
          "pm.collectionVariables.set('freeEnd', addDays(72));"
        ]
      }
    }
  ],
